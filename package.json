    "./critical-duration": "./src/critical-duration.js",
    "./critical-equipment": "./src/critical-equipment.js",
    "./critical-initiative": "./src/critical-initiative.js",
    "./critical-recoil": "./src/critical-recoil.js",
    "./critical-source": "./src/critical-source.js",
    "./critical-stun": "./src/critical-stun.js",
